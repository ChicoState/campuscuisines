# Local Compose defaults are safe development-only values. Do not place real
# credentials in this file or commit a populated .env file.
POSTGRES_DB=campuscuisines
POSTGRES_USER=campuscuisines
POSTGRES_PASSWORD=change-this-local-only
MINIO_ROOT_USER=local-minio-user
MINIO_ROOT_PASSWORD=change-this-local-only
DATABASE_URL=postgresql://campuscuisines:change-this-local-only@postgres:5432/campuscuisines
OBJECT_STORAGE_ENDPOINT=http://minio:9000
# Browser-facing endpoint used only when Django creates signed image URLs.
OBJECT_STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=campus-cuisines-uploads
OBJECT_STORAGE_ACCESS_KEY=local-minio-user
OBJECT_STORAGE_SECRET_KEY=change-this-local-only
OBJECT_STORAGE_REGION=us-east-1
DJANGO_SECRET_KEY=replace-with-a-local-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Explicit local-development opt-in. Django defaults to secure non-debug mode.
DJANGO_DEBUG=true
